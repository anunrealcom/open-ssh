# =====================================================================
# Open SSH / xiaobaiOP (Qt6 / CMake) — Git 忽略规则
# 原则：源码、构建脚本、资源、文档入库；
#       编译产物、发布包、下载依赖、个人 IDE 配置不入库
# =====================================================================

# ---------------- 1. 构建输出目录 ----------------
build/
Build/
build-*/
cmake-build-*/
out/
_build/
/bin/
/obj/
b2/

# ---------------- 2. CMake 生成物 ----------------
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
/Makefile
*.ninja
.ninja_*
Testing/
CTestTestfile.cmake
_deps/
/install/

# ---------------- 3. Qt 中间产物 ----------------
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
ui_*.h
*.moc
*_autogen/
a.out

